---
import NotionLayout from '../layouts/NotionLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => {
    const slug = doc.data.slug || doc.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { doc },
    };
  });
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const frontmatter = doc.data;
const title = frontmatter.title || doc.id;
const domain = frontmatter.domain || '';
const subdomain = frontmatter.subdomain || '';
const status = frontmatter.status || 'canonical';
const version = frontmatter.version || '1.0.0';
const summary = frontmatter.summary || '';
const tags = frontmatter.tags || [];
const anchors = frontmatter.academic_anchors || [];
const audit = frontmatter.audit;

const breadcrumbs = [
  { label: 'Design Grimoar', href: '/' },
  { label: domain || 'Domínio' },
  { label: title },
];
---

<NotionLayout title={`${title} — Design Grimoar`} description={summary} breadcrumbs={breadcrumbs} currentSlug={frontmatter.slug}>
  <!-- Notion Page Icon -->
  <div class="notion-page-icon">📄</div>

  <!-- Notion Page Title -->
  <h1 class="notion-page-title">{title}</h1>

  <!-- Notion Properties Table -->
  <div class="notion-properties">
    <div class="notion-property-row">
      <div class="notion-property-key"><span>🏷️</span> <span>Status</span></div>
      <div class="notion-property-value">
        <span class="notion-tag">{status}</span>
        {audit?.status && (
          <span class="notion-tag" style="margin-left: 6px; background-color: var(--bg-hover);">
            Auditoria: {audit.status}
          </span>
        )}
      </div>
    </div>

    {domain && (
      <div class="notion-property-row">
        <div class="notion-property-key"><span>📂</span> <span>Domínio</span></div>
        <div class="notion-property-value">{domain} {subdomain ? `› ${subdomain}` : ''}</div>
      </div>
    )}

    <div class="notion-property-row">
      <div class="notion-property-key"><span>🔢</span> <span>Versão</span></div>
      <div class="notion-property-value">{version}</div>
    </div>

    {anchors.length > 0 && (
      <div class="notion-property-row">
        <div class="notion-property-key"><span>🎓</span> <span>Âncoras</span></div>
        <div class="notion-property-value">
          {anchors.join(' • ')}
        </div>
      </div>
    )}

    {tags.length > 0 && (
      <div class="notion-property-row">
        <div class="notion-property-key"><span>🔖</span> <span>Tags</span></div>
        <div class="notion-property-value">
          <div class="notion-tags">
            {tags.map((tag: string) => (
              <span class="notion-tag">#{tag}</span>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>

  <!-- Resumo Canônico Callout -->
  {summary && (
    <div class="notion-callout">
      <div class="notion-callout-icon">💡</div>
      <div class="notion-callout-body">
        <strong>Síntese Conceitual:</strong> {summary}
      </div>
    </div>
  )}

  <!-- Corpo do Verbete (As 5 Seções Obrigatórias) -->
  <article class="notion-content">
    <Content />
  </article>
</NotionLayout>
