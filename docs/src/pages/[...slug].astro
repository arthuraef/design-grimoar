---
import NotionLayout from '../layouts/NotionLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const canonicalDocs = docs.filter((doc) => {
    const status = doc.data?.status;
    const auditStatus = doc.data?.audit?.status;
    return (status === 'canonical' || status === 'audited') && auditStatus === 'APPROVED';
  });
  return canonicalDocs.map((doc) => {
    const slug = doc.data.slug || doc.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { doc, allDocs: canonicalDocs },
    };
  });
}

function slugify(text: string) {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

const { doc, allDocs = [] } = Astro.props;
const { Content } = await render(doc);

const frontmatter = doc.data;
const title = frontmatter.title || doc.id;
const currentSlug = frontmatter.slug || doc.id.replace(/\.md$/, '');
const titleSlug = slugify(title);
const aliasSlugs = (frontmatter.aliases || []).map((a: string) => slugify(a));

// Identificar Backlinks (Verbetes publicados que contêm [[WikiLinks]] apontando para este verbete)
const backlinks = (allDocs as any[])
  .filter((d) => d.id !== doc.id)
  .filter((d) => {
    const rawBody = d.body || '';
    if (!rawBody.includes('[[')) return false;
    const matches = rawBody.matchAll(/\[\[([^\]|]+)(?:\|[^\]]+)?\]\]/g);
    for (const match of matches) {
      const targetSlug = slugify(match[1]);
      if (
        targetSlug === currentSlug ||
        targetSlug === titleSlug ||
        aliasSlugs.includes(targetSlug)
      ) {
        return true;
      }
    }
    return false;
  })
  .map((d) => ({
    title: d.data.title || d.id,
    slug: d.data.slug || d.id.replace(/\.md$/, ''),
    domain: d.data.domain || '',
    summary: d.data.summary || '',
  }));
const domain = frontmatter.domain || '';
const subdomain = frontmatter.subdomain || '';
const status = frontmatter.status || 'canonical';
const version = frontmatter.version || '1.0.0';
const summary = frontmatter.summary || '';
const tags = frontmatter.tags || [];
const anchors = frontmatter.academic_anchors || [];
const audit = frontmatter.audit;

const breadcrumbs = [
  { label: 'Design Grimoar', href: '/' },
  { label: domain || 'Domínio' },
  { label: title },
];
---

<NotionLayout title={`${title} — Design Grimoar`} description={summary} breadcrumbs={breadcrumbs} currentSlug={frontmatter.slug}>
  <!-- Envoltório Canônico indexável pelo Pagefind -->
  <article data-pagefind-body>
    <!-- Notion Page Icon -->
    <div class="notion-page-icon" data-pagefind-ignore>📄</div>

    <!-- Notion Page Title -->
    <h1 class="notion-page-title" data-pagefind-meta="title">{title}</h1>

    <!-- Notion Properties Table & Filtros Facetados Pagefind -->
    <div class="notion-properties">
      <div class="notion-property-row">
        <div class="notion-property-key"><span>🏷️</span> <span data-i18n="doc.prop_status">Status</span></div>
        <div class="notion-property-value">
          <span class="notion-tag" data-pagefind-filter="Status">{status}</span>
          {audit?.status && (
            <span class="notion-tag" style="margin-left: 6px; background-color: var(--bg-hover);">
              <span data-i18n="doc.prop_audit">Auditoria:</span> {audit.status}
            </span>
          )}
        </div>
      </div>

      {domain && (
        <div class="notion-property-row">
          <div class="notion-property-key"><span>📂</span> <span data-i18n="doc.prop_domain">Domínio</span></div>
          <div class="notion-property-value">
            <span class="notion-tag" data-pagefind-filter="Categoria" style="font-weight: 500;">
              {domain}
            </span>
            {subdomain && (
              <span style="margin-left: 6px; font-size: 13px; color: var(--text-muted);">
                › <span data-pagefind-filter="Subcategoria">{subdomain}</span>
              </span>
            )}
          </div>
        </div>
      )}

      <div class="notion-property-row">
        <div class="notion-property-key"><span>🔢</span> <span data-i18n="doc.prop_version">Versão</span></div>
        <div class="notion-property-value">{version}</div>
      </div>

      {anchors.length > 0 && (
        <div class="notion-property-row">
          <div class="notion-property-key"><span>🎓</span> <span data-i18n="doc.prop_anchors">Âncoras</span></div>
          <div class="notion-property-value" data-pagefind-meta="anchors">
            {anchors.join(' • ')}
          </div>
        </div>
      )}

      {tags.length > 0 && (
        <div class="notion-property-row">
          <div class="notion-property-key"><span>🔖</span> <span data-i18n="doc.prop_tags">Tags</span></div>
          <div class="notion-property-value">
            <div class="notion-tags">
              {tags.map((tag: string) => (
                <span class="notion-tag" data-pagefind-filter="Tags">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Resumo Canônico Callout -->
    {summary && (
      <div class="notion-callout" data-pagefind-meta="summary">
        <div class="notion-callout-icon" data-pagefind-ignore>💡</div>
        <div class="notion-callout-body">
          <strong data-i18n="doc.callout_synthesis">Síntese Conceitual:</strong> {summary}
        </div>
      </div>
    )}

    <!-- Corpo do Verbete (As 5 Seções Obrigatórias) -->
    <div class="notion-content">
      <Content />
    </div>

    <!-- Seção Minimalista de Backlinks (Mencionado em) -->
    {backlinks.length > 0 && (
      <div class="notion-backlinks" data-pagefind-ignore>
        <div class="notion-backlinks-header">
          <span class="notion-backlinks-icon">🔗</span>
          <span class="notion-backlinks-title" data-i18n="doc.backlinks_title" data-i18n-count={backlinks.length}>
            Mencionado em ({backlinks.length})
          </span>
        </div>
        <div class="notion-backlinks-list">
          {backlinks.map((bl) => (
            <a href={`/design-grimoar/${bl.slug}`} class="notion-backlink-item">
              <span class="notion-backlink-item-icon">📄</span>
              <div class="notion-backlink-item-content">
                <span class="notion-backlink-item-title">{bl.title}</span>
                {bl.domain && <span class="notion-backlink-item-domain">{bl.domain}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>
</NotionLayout>
