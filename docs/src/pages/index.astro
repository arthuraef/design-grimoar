---
import NotionLayout from '../layouts/NotionLayout.astro';
import { getCollection } from 'astro:content';

let allVerbetes: any[] = [];
try {
  const rawVerbetes = await getCollection('docs');
  allVerbetes = rawVerbetes.filter((v: any) => {
    const status = v.data?.status;
    const auditStatus = v.data?.audit?.status;
    return (status === 'canonical' || status === 'audited') && auditStatus === 'APPROVED';
  });
} catch (e) {
  allVerbetes = [];
}

const domains = [
  { id: '01-psicologia-cognitiva', code: '01', title: 'Psicologia Cognitiva', titleKey: 'domain.01.title', icon: '🧠', desc: 'Carga cognitiva, modelos mentais, vieses heurísticos e percepção visual.', descKey: 'domain.01.desc' },
  { id: '02-ux-interaction-design', code: '02', title: 'UX & Interaction Design', titleKey: 'domain.02.title', icon: '📐', desc: 'Affordances, signifiers, arquitetura de informação e heurísticas de usabilidade.', descKey: 'domain.02.desc' },
  { id: '03-ui-visual-design', code: '03', title: 'UI & Visual Design', titleKey: 'domain.03.title', icon: '🎨', desc: 'Tipografia editorial, contraste perceptual, teoria da cor e ritmo espacial.', descKey: 'domain.03.desc' },
  { id: '04-design-systems', code: '04', title: 'Design Systems', titleKey: 'domain.04.title', icon: '🧱', desc: 'Design tokens, componentes atômicos, acessibilidade e governança de escala.', descKey: 'domain.04.desc' },
  { id: '05-product-design-strategy', code: '05', title: 'Product Design Strategy', titleKey: 'domain.05.title', icon: '🎯', desc: 'Problem framing, discovery contínuo, hipóteses de valor e métricas de impacto.', descKey: 'domain.05.desc' },
  { id: '06-designops-engineering', code: '06', title: 'DesignOps & Engineering', titleKey: 'domain.06.title', icon: '⚙️', desc: 'Handoff determinístico, automação de esteiras CI/CD e auditoria de qualidade.', descKey: 'domain.06.desc' },
];

const base = import.meta.env.BASE_URL || '/';
const cleanBase = base ? base.replace(/\/$/, '') : '';
---

<NotionLayout title="Design Grimoar — Enciclopédia Canônica de Product Design" currentSlug="">
  <!-- Notion Page Icon -->
  <div class="notion-page-icon">📓</div>

  <!-- Notion Page Title -->
  <h1 class="notion-page-title" data-i18n="breadcrumbs.home">Design Grimoar</h1>

  <!-- Hero Search (Campo de Busca no Corpo da Página) -->
  <div class="notion-hero-search-container" data-body-search>
    <div 
      class="notion-hero-search-bar" 
      id="hero-search-trigger" 
      role="button" 
      tabindex="0" 
      aria-label="Pesquisar verbetes e cânones no Grimoar (Cmd + K)"
      data-i18n-aria="home.hero_placeholder"
    >
      <div class="notion-hero-search-left">
        <span class="notion-hero-search-icon">🔍</span>
        <span class="notion-hero-search-placeholder" data-i18n="home.hero_placeholder">Pesquisar verbetes, heurísticas, conceitos e âncoras acadêmicas...</span>
      </div>
      <div class="notion-hero-search-right">
        <kbd class="notion-hero-kbd">⌘K</kbd>
        <span class="notion-hero-search-action" data-i18n="home.hero_action">Buscar</span>
      </div>
    </div>

    <!-- Pílulas de Termos Canônicos Rápidos -->
    <div class="notion-hero-quick-tags">
      <span class="notion-quick-label" data-i18n="home.explore">Explorar:</span>
      <button type="button" class="notion-quick-pill" data-quick-search="Affordance">Affordance</button>
      <button type="button" class="notion-quick-pill" data-quick-search="Cognitive Load">Cognitive Load</button>
      <button type="button" class="notion-quick-pill" data-quick-search="Fitts's Law">Fitts's Law</button>
      <button type="button" class="notion-quick-pill" data-quick-search="Jakob's Law">Jakob's Law</button>
      <button type="button" class="notion-quick-pill" data-quick-search="Psicologia Cognitiva">Psicologia Cognitiva</button>
    </div>
  </div>

  <!-- Notion Properties Block -->
  <div class="notion-properties">
    <div class="notion-property-row">
      <div class="notion-property-key"><span>🏛️</span> <span data-i18n="home.prop_type">Tipo</span></div>
      <div class="notion-property-value" data-i18n="home.prop_type_val">Tratado Canônico & Enciclopédia Autônoma</div>
    </div>
    <div class="notion-property-row">
      <div class="notion-property-key"><span>🌐</span> <span data-i18n="home.prop_front">Front-end</span></div>
      <div class="notion-property-value" data-i18n="home.prop_front_val">GitHub Pages (Experiência Notion-like)</div>
    </div>
    <div class="notion-property-row">
      <div class="notion-property-key"><span>🧠</span> <span data-i18n="home.prop_orch">Orquestrador</span></div>
      <div class="notion-property-value">DeepSeek Harness + Cordis Framework</div>
    </div>
    <div class="notion-property-row">
      <div class="notion-property-key"><span>🏷️</span> <span data-i18n="home.prop_status">Status</span></div>
      <div class="notion-property-value"><span class="notion-tag">canonical</span></div>
    </div>
  </div>

  <div class="notion-content">
    <!-- Callout Manifesto -->
    <div class="notion-callout">
      <div class="notion-callout-icon">🕯️</div>
      <div class="notion-callout-body">
        <strong data-i18n="home.manifesto_title">Manifesto Curatorial:</strong> 
        <span data-i18n="home.manifesto_text">
          O design não habita a camada decorativa do artefato; 
          constitui a estrutura invisível da cognição humana. O Grimoar existe para destilar o conhecimento disperso da indústria 
          em um cânone rigoroso, ancorado na ciência da percepção e na computação aplicada.
        </span>
      </div>
    </div>

    <!-- Regra de Nomenclatura Callout -->
    <div class="notion-callout">
      <div class="notion-callout-icon">◽️</div>
      <div class="notion-callout-body">
        <strong data-i18n="home.nomenclature_title">Diretriz de Nomenclatura:</strong> 
        <span data-i18n="home.nomenclature_text">
          Todos os termos técnicos, <em>frameworks</em> e conceitos da indústria 
          são mantidos estritamente em seu idioma original (<em>English</em>). A tradução para o Português do Brasil ocorre 
          no máximo uma única vez, na sentença de abertura do verbete, estritamente para contextualização inicial.
        </span>
      </div>
    </div>

    <h2 data-i18n="home.tax_title">Taxonomia Canônica & Domínios Oficiais</h2>
    <p data-i18n="home.tax_desc">
      O Grimoar organiza o conhecimento em 6 domínios estruturais. Cada verbete é sintetizado de fontes canônicas 
      e auditado rigorosamente pela academia antes da publicação.
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin: 28px 0;">
      {domains.map((dom) => {
        const verbetesCount = allVerbetes.filter((v) => {
          const d = v.data?.domain || (v.id && v.id.startsWith(dom.id) ? dom.id : '');
          return d === dom.id;
        }).length;

        return (
          <div style="border: 1px solid var(--border-subtle); border-radius: 6px; padding: 20px; background-color: var(--bg-surface); transition: background-color 0.15s ease;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <span style="font-size: 24px;">{dom.icon}</span>
              <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-faint); letter-spacing: 0.05em;">
                <span data-i18n="home.domain_code">Domínio</span> {dom.code}
              </span>
            </div>
            <h3 style="font-size: 16px; margin-top: 0; margin-bottom: 6px; color: var(--text-main);" data-i18n={dom.titleKey}>
              {dom.title}
            </h3>
            <p style="font-size: 13.5px; color: var(--text-muted); margin-bottom: 12px; line-height: 1.5;" data-i18n={dom.descKey}>
              {dom.desc}
            </p>
            <div
              style="font-size: 12px; color: var(--text-faint);"
              data-i18n={verbetesCount === 1 ? 'home.single_verbete' : 'home.plural_verbetes'}
              data-i18n-count={verbetesCount}
            >
              {verbetesCount === 1 ? '1 verbete catalogado' : `${verbetesCount} verbetes catalogados`}
            </div>
          </div>
        );
      })}
    </div>

    <h2 data-i18n="home.featured_title">Verbetes em Destaque</h2>
    <table>
      <thead>
        <tr>
          <th data-i18n="home.th_verbete">Verbete</th>
          <th data-i18n="home.th_domain">Domínio</th>
          <th data-i18n="home.th_status">Status</th>
          <th data-i18n="home.th_anchors">Âncoras Acadêmicas</th>
        </tr>
      </thead>
      <tbody>
        {allVerbetes.map((verbete) => {
          const slug = verbete.data?.slug || verbete.slug || verbete.id.replace(/\.md$/, '');
          const title = verbete.data?.title || slug;
          const domain = verbete.data?.domain || 'Cânone';
          const status = verbete.data?.status || 'canonical';
          const anchors = verbete.data?.academic_anchors?.slice(0, 2)?.join(', ') || 'Sob revisão';

          return (
            <tr>
              <td>
                <a href={`${cleanBase}/${slug}`} class="notion-wikilink" style="font-weight: 600;">
                  📄 {title}
                </a>
              </td>
              <td style="font-size: 13px; color: var(--text-muted);">{domain}</td>
              <td><span class="notion-tag">{status}</span></td>
              <td style="font-size: 12.5px; color: var(--text-muted);">{anchors}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</NotionLayout>
