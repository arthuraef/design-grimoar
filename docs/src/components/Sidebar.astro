---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
  base?: string;
}

const { currentSlug = '', base = '' } = Astro.props;

// Lista canônica de domínios com títulos e ícones refinados
const domains = [
  { id: '01-psicologia-cognitiva', label: '01. Psicologia Cognitiva', icon: '🧠', i18nKey: 'domain.01.label' },
  { id: '02-ux-interaction-design', label: '02. UX & Interaction', icon: '📐', i18nKey: 'domain.02.label' },
  { id: '03-ui-visual-design', label: '03. UI & Visual Design', icon: '🎨', i18nKey: 'domain.03.label' },
  { id: '04-design-systems', label: '04. Design Systems', icon: '🧱', i18nKey: 'domain.04.label' },
  { id: '05-product-design-strategy', label: '05. Product Strategy', icon: '🎯', i18nKey: 'domain.05.label' },
  { id: '06-designops-engineering', label: '06. DesignOps & Eng.', icon: '⚙️', i18nKey: 'domain.06.label' },
];

let allVerbetes: any[] = [];
try {
  const rawVerbetes = await getCollection('docs');
  allVerbetes = rawVerbetes.filter((v: any) => {
    const status = v.data?.status;
    const auditStatus = v.data?.audit?.status;
    return (status === 'canonical' || status === 'audited') && auditStatus === 'APPROVED';
  });
} catch (e) {
  allVerbetes = [];
}

const cleanBase = base ? base.replace(/\/$/, '') : '';
---

<aside class="notion-sidebar">
  <div class="notion-sidebar-header">
    <a href={`${cleanBase}/`} class="notion-brand">
      <span class="notion-brand-icon">📓</span>
      <span>Design Grimoar</span>
    </a>
  </div>

  <!-- Botão de Busca Rápida Estilo Notion (Quick Find / Command Palette) -->
  <button
    type="button"
    class="notion-sidebar-search-btn"
    id="sidebar-search-trigger"
    aria-label="Abrir busca no Grimoar (Cmd + K)"
    data-i18n-aria="sidebar.search_placeholder"
  >
    <span class="notion-sidebar-search-icon">🔍</span>
    <span class="notion-sidebar-search-text" data-i18n="sidebar.search_placeholder">Buscar no Grimoar...</span>
    <kbd class="notion-kbd">⌘K</kbd>
  </button>

  <nav class="notion-sidebar-nav">
    <a href={`${cleanBase}/`} class={`notion-nav-item ${currentSlug === '' ? 'active' : ''}`}>
      <span class="notion-nav-icon">◽️</span>
      <span data-i18n="sidebar.nav_home">Início / Cânone</span>
    </a>

    {domains.map((domain) => {
      const verbetesInDomain = allVerbetes.filter((v) => {
        const d = v.data?.domain || (v.id && v.id.startsWith(domain.id) ? domain.id : '');
        return d === domain.id;
      });

      return (
        <div class="notion-sidebar-section">
          <div class="notion-sidebar-title" data-i18n={domain.i18nKey}>{domain.label}</div>
          {verbetesInDomain.length === 0 ? (
            <div
              style="font-size: 12px; color: var(--text-faint); padding: 4px 10px; font-style: italic;"
              data-i18n="sidebar.curating"
            >
              Em curadoria...
            </div>
          ) : (
            verbetesInDomain.map((verbete) => {
              const slug = verbete.data?.slug || verbete.slug || verbete.id.replace(/\.md$/, '');
              const title = verbete.data?.title || slug;
              const isActive = currentSlug === slug;
              const linkHref = `${cleanBase}/${slug}`;

              return (
                <a href={linkHref} class={`notion-nav-item ${isActive ? 'active' : ''}`}>
                  <span class="notion-nav-icon">📄</span>
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    {title}
                  </span>
                </a>
              );
            })
          )}
        </div>
      );
    })}
  </nav>
</aside>
