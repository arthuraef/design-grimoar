# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — DESIGN GRIMOAR (ORACLE CLOUD ALWAYS FREE ARM64)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS RELACIONAL & VETORIAL (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=design_grimoar
POSTGRES_USER=grimoar
POSTGRES_PASSWORD=alterar_para_senha_segura_em_producao
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# String de conexão completa consumida pelo pool do Node.js (Publisher & SemanticRouter)
DATABASE_URL=postgresql://grimoar:alterar_para_senha_segura_em_producao@localhost:5432/design_grimoar

# ------------------------------------------------------------------------------
# 2. INGESTÃO WEB DETERMINÍSTICA (Firecrawl MCP / REST) & MODO FURTIVO
# ------------------------------------------------------------------------------
# Chave de API do Firecrawl (Cloud ou Self-hosted autenticado)
FIRECRAWL_API_KEY=
# URL base do Firecrawl:
# - Nuvem: https://api.firecrawl.dev
# - Docker local (Oracle Cloud): http://firecrawl-engine:3002
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Rate Limiting Furtivo: Simulação de navegação humana (Anti-WAF / Cloudflare)
# Máximo de 2 a 3 verbetes por hora. Jitter aleatório entre 15 e 40 minutos entre requisições.
STEALTH_MODE=true
STEALTH_MIN_MINUTES=15
STEALTH_MAX_MINUTES=40
MAX_VERBETES_PER_HOUR=3

# ------------------------------------------------------------------------------
# 3. INGESTÃO DE ÁUDIO (Microsoft VibeVoice ASR 0.5B)
# ------------------------------------------------------------------------------
# Endpoint HTTP do serviço de ASR caso executado em container/servidor dedicado
VIBEVOICE_API_URL=
# Identificador do modelo no Hugging Face caso utilize execução local via Python
VIBEVOICE_MODEL_ID=microsoft/VibeVoice-ASR-0.5B

# ------------------------------------------------------------------------------
# 4. GERAÇÃO DE EMBEDDINGS VETORIAIS (1536 Dimensões para HNSW pgvector)
# ------------------------------------------------------------------------------
# Provedor padrão: OpenAI text-embedding-3-small (1536 dimensões) ou compatível
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Limiar de similaridade de cosseno (>= 0.82 ativa modo MERGE; < 0.82 ativa CREATE)
SIMILARITY_THRESHOLD=0.82

# ------------------------------------------------------------------------------
# 5. ETAPA 2: SÍNTESE LEXICOGRÁFICA (Agente Gerador - DeepSeek Chat)
# ------------------------------------------------------------------------------
LEXICOGRAPHER_API_KEY=
# Ou utilize DEEPSEEK_API_KEY diretamente
DEEPSEEK_API_KEY=
LEXICOGRAPHER_BASE_URL=https://api.deepseek.com
LEXICOGRAPHER_MODEL=deepseek-chat
LEXICOGRAPHER_TEMPERATURE=0.2
LEXICOGRAPHER_PROMPT_PATH=prompts/step2-lexicographer.md

# ------------------------------------------------------------------------------
# 6. ETAPA 3: AUDITORIA ACADÊMICA (Agente Verificador - Isolamento Obrigatório)
# Regra Inegociável 2: Prompts e chamadas independentes para evitar viés
# ------------------------------------------------------------------------------
ACADEMIC_AUDITOR_API_KEY=
# Ou utilize OPENAI_API_KEY diretamente
OPENAI_API_KEY=
ACADEMIC_AUDITOR_BASE_URL=https://api.openai.com/v1
ACADEMIC_AUDITOR_MODEL=gpt-4o
ACADEMIC_AUDITOR_TEMPERATURE=0.1
ACADEMIC_AUDITOR_PROMPT_PATH=prompts/step3-academic-auditor.md

# Limite máximo de retentativas do Loop de Refinamento (Lexicógrafo <-> Auditor <-> Zod)
VERIFICATION_LOOP_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 7. ETAPA 5: PUBLICAÇÃO ATÔMICA, GIT & FRONT-END GITHUB PAGES
# ------------------------------------------------------------------------------
# Token de acesso pessoal do GitHub para operações de push (Least Privilege: usado APENAS no Publisher)
GITHUB_TOKEN=
GITHUB_BRANCH=main
GITHUB_REPO=ArthurAEF/Design-Grimoar

# Diretório de conteúdo do gerador de site estático (Astro Notion-like SSG)
STATIC_SITE_CONTENT_DIR=./docs/src/content/docs

# ------------------------------------------------------------------------------
# 8. NOTIFICAÇÕES & CRON: HERMES AGENT (Nous Research Pattern)
# ------------------------------------------------------------------------------
# Endpoint interno do servidor Webhook do Hermes Agent
HERMES_AGENT_API_URL=http://localhost:5055/webhook/step-completed
HERMES_PORT=5055
# Webhook externo para entrega no dispositivo móvel/desktop (Discord, Telegram, Slack ou ntfy)
NOTIFICATIONS_WEBHOOK_URL=
# Agendamento Cron para verificação diária de integridade e fontes pendentes
HERMES_CRON_SCHEDULE="0 3 * * *"

# ------------------------------------------------------------------------------
# 9. AMBIENTE, RECURSOS ARM64 & CONTROLE DE TESTES
# ------------------------------------------------------------------------------
# Em produção (production), chamadas reais são obrigatórias e chaves ausentes lançam erro.
# Em teste (test), fallbacks determinísticos são permitidos para execução offline de CI/CD.
NODE_ENV=production
ALLOW_TEST_FALLBACKS=false
LOG_LEVEL=info

# UID/GID para compatibilidade de permissões nos bind mounts (Ubuntu host <-> container)
PUID=1000
PGID=1000

# Limite de memória da V8 (Heap limit de 512MB para coexistência segura em OCI Always Free ARM64)
NODE_OPTIONS=--max-old-space-size=512

# Identidade autônoma do Git para commits automáticos de verbetes
GIT_AUTHOR_NAME=Grimoar Autonomous Agent
GIT_AUTHOR_EMAIL=grimoar-bot@users.noreply.github.com

