# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — DESIGN GRIMOAR (ORACLE CLOUD ARM64)
# ==============================================================================

# Banco de Dados (PostgreSQL + pgvector)
POSTGRES_DB=design_grimoar
POSTGRES_USER=grimoar
POSTGRES_PASSWORD=alterar_para_senha_segura_em_producao
POSTGRES_PORT=5432

# Ingestão Firecrawl
# Se utilizar a API na Nuvem da Firecrawl, defina aqui. O docker-compose suporta tanto a engine local quanto a Cloud API.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=http://firecrawl-engine:3002

# Provedores de LLM para Etapas Cognitivas (Isolamento Generator-Verifier)
# Etapa 2: Lexicógrafo
DEEPSEEK_API_KEY=
# Etapa 3: Auditor Acadêmico (Isolamento de API / Sistema)
OPENAI_API_KEY=

# Notificações Hermes Agent (Nous Research)
NOTIFICATIONS_WEBHOOK_URL=
HERMES_CRON_SCHEDULE="0 3 * * *"

# Configurações do Cordis / DSH
NODE_ENV=production
LOG_LEVEL=info
